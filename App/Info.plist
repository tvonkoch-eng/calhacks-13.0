	<string>Tells you what is next on your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>Recognizes your teammates' faces on device.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lets your phone find and connect to your glasses over Wi-Fi.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Finds places near you when you ask.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Listens for questions so answers can appear on your glasses. Audio is transcribed by Meta's Muse Voice Transcribe.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Sets reminders when you ask.</string>
