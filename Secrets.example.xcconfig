// cp Secrets.example.xcconfig Secrets.xcconfig, then fill this in. Secrets.xcconfig is gitignored;
// the app and tools/live-mac.sh both read it. A lane with no key is off.

// Speech-to-text with who-said-what: Muse Voice Transcribe, dev.meta.ai.
MUSE_API_KEY =

// Raw keys, referenced below.
CEREBRAS_API_KEY =
OPENAI_API_KEY =

// Answers to questions asked out loud, and (by default) the coach.
// Target: cerebras gpt-oss-120b (OpenAI's open-weight model; not on OpenAI's own API).
// Until there's a Cerebras key: openai gpt-4.1-mini, 0.66 s median first word, 20/20 answer-vs-SKIP.
// Also supported: groq, muse (Muse Spark, ~1 s), via the same three lines.
ANSWER_PROVIDER = cerebras
ANSWER_API_KEY = $(CEREBRAS_API_KEY)
ANSWER_MODEL =

// The coach (definitions, what to say next, who they are). Defaults to the answer provider.
COACH_PROVIDER =
COACH_API_KEY =
COACH_MODEL =

// Used while the answer or coach provider is rate-limited. Optional.
BACKUP_PROVIDER = openai
BACKUP_API_KEY = $(OPENAI_API_KEY)
BACKUP_MODEL =

// Deeper lookups the coach asks for now and then: off | openai | groq | asi1 (Fetch.ai ASI:One).
// Each lookup costs ~17-20k tokens and a few seconds.
RESEARCH_PROVIDER = off
RESEARCH_API_KEY =
RESEARCH_MODEL =

// What you already know, so the coach doesn't define it. Optional.
WEARER_BACKGROUND =
