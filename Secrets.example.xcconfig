// cp Secrets.example.xcconfig Secrets.xcconfig, then fill this in. Secrets.xcconfig is gitignored;
// the app and tools/live-mac.sh both read it. A lane with no key is off.

// Speech-to-text with who-said-what: Muse Voice Transcribe, dev.meta.ai.
MUSE_API_KEY =

// Raw keys, referenced below.
CEREBRAS_API_KEY =
OPENAI_API_KEY =

// Answers to questions asked out loud, and (by default) the coach.
// cerebras gpt-oss-120b: 0.23 s median first word, 20/20 answer-vs-SKIP (Tests/answer-latency.py).
// Also: openai (gpt-4.1-mini, 0.66 s), groq, muse (Muse Spark, ~1 s).
ANSWER_PROVIDER = cerebras
ANSWER_API_KEY = $(CEREBRAS_API_KEY)
ANSWER_MODEL = gpt-oss-120b
// Cerebras' free tier allows gpt-oss-120b 5 requests a minute; past that, calls go to the backup.
ANSWER_PER_MINUTE = 5

// The coach (definitions, what to say next, who they are). Defaults to the answer provider.
COACH_PROVIDER =
COACH_API_KEY =
COACH_MODEL =

// Used while the answer or coach model is rate-limited or past ANSWER_PER_MINUTE.
// cerebras qwen-3.8-27b: 0.17 s, 20/20, 450 requests a minute on the same key.
BACKUP_PROVIDER = cerebras
BACKUP_API_KEY = $(CEREBRAS_API_KEY)
BACKUP_MODEL = qwen-3.8-27b

// Research (tier 3: the coach's lookups and the `research` tool): off | asi1 (Fetch.ai ASI:One,
// agentic; RESEARCH_MODEL defaults to asi1-fast-agentic) | openai | groq. With OPENAI_API_KEY set,
// OpenAI's web search backs up whichever is first. Each lookup is several seconds.
RESEARCH_PROVIDER = off
RESEARCH_API_KEY =
RESEARCH_MODEL =

// Your first name, so the aid can tell your self-introduction from theirs. Defaults to Toby.
WEARER_NAME =

// What you already know, so the coach doesn't define it. Optional.
WEARER_BACKGROUND =

// Tools (places, weather, reminders, calendar) are keyless and on by default; "off" disables them.
TOOLS =
// "37.7880,-122.4075": pin the location instead of asking Core Location (testing, or a Mac).
TEST_LOCATION =
