// cp Secrets.example.xcconfig Secrets.xcconfig, then fill this in. Secrets.xcconfig is gitignored;
// the app and tools/live-mac.sh both read it. A lane with no key is off.

// Speech-to-text with who-said-what: Muse Voice Transcribe, dev.meta.ai.
MUSE_API_KEY =

// Raw keys, referenced below.
GROQ_API_KEY =
OPENAI_API_KEY =

// Answers to questions asked out loud: fastest first token wins. groq | openai | cerebras | muse.
// groq qwen3.8-27b: 0.19 s median first word, 20/20 answer-vs-SKIP (Tests/groq-latency.py).
ANSWER_PROVIDER = groq
ANSWER_API_KEY = $(GROQ_API_KEY)
ANSWER_MODEL =

// The coach (definitions, what to say next, who they are). Defaults to the answer provider.
COACH_PROVIDER =
COACH_API_KEY =
COACH_MODEL =

// Used while the answer or coach provider is rate-limited (Groq's free tier is 200k tokens/day).
// openai gpt-4.1-mini: 0.66 s median first word, 20/20.
BACKUP_PROVIDER = openai
BACKUP_API_KEY = $(OPENAI_API_KEY)
BACKUP_MODEL =

// Deeper lookups the coach asks for now and then: off | openai | groq | asi1 (Fetch.ai ASI:One).
// Each lookup costs ~17-20k tokens; groq's would come out of the free daily budget.
RESEARCH_PROVIDER = off
RESEARCH_API_KEY =
RESEARCH_MODEL =

// What you already know, so the coach doesn't define it. Optional.
WEARER_BACKGROUND =
