	<string>$(ANSWER_API_KEY)</string>
	<key>AnswerModel</key>
	<string>$(ANSWER_MODEL)</string>
	<key>AnswerPerMinute</key>
	<string>$(ANSWER_PER_MINUTE)</string>
	<key>AnswerProvider</key>
	<string>$(ANSWER_PROVIDER)</string>
